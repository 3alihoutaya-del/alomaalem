<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>

<meta charset="UTF-8">

<meta name="viewport"
      content="width=device-width, initial-scale=1.0">

<title>تفاصيل المباراة | TactiGol News</title>

<meta name="description"
      content="تفاصيل المباراة، الموعد، النتيجة، البطولة والملعب - TactiGol News">


<style>

/* =====================================================
   VARIABLES
===================================================== */

:root {

    --green: #00a86b;

    --green-dark: #078153;

    --bg: #f4f6f8;

    --card: #ffffff;

    --text: #111827;

    --muted: #6b7280;

    --border: #e5e7eb;

    --header: #07111f;

    --shadow:
        0 8px 25px rgba(0,0,0,.07);

}


/* =====================================================
   DARK MODE
===================================================== */

body.dark {

    --bg: #07111f;

    --card: #0f1b2b;

    --text: #f3f4f6;

    --muted: #aab4c0;

    --border: #263548;

    --header: #050c15;

    --shadow:
        0 8px 25px rgba(0,0,0,.30);

}


/* =====================================================
   RESET
===================================================== */

* {

    box-sizing: border-box;

    margin: 0;

    padding: 0;

}


body {

    font-family:
        Arial,
        Tahoma,
        sans-serif;

    background: var(--bg);

    color: var(--text);

    line-height: 1.7;

    transition:
        background .25s,
        color .25s;

}


a {

    color: inherit;

    text-decoration: none;

}


button {

    font-family: inherit;

}


/* =====================================================
   HEADER
===================================================== */

.header {

    background:
        linear-gradient(
            135deg,
            #07111f,
            #0d2136
        );

    color: white;

    position: sticky;

    top: 0;

    z-index: 1000;

    box-shadow:
        0 4px 20px rgba(0,0,0,.18);

}


.header-inner {

    max-width: 1200px;

    min-height: 72px;

    margin: auto;

    padding: 10px 18px;

    display: flex;

    align-items: center;

    gap: 18px;

}


/* =====================================================
   LOGO
===================================================== */

.logo {

    min-width: 145px;

    font-size: 27px;

    font-weight: 900;

    line-height: 1.1;

}


.logo span {

    color: var(--green);

}


.logo small {

    display: block;

    color: #9ca9b7;

    font-size: 8px;

    letter-spacing: 4px;

    text-align: center;

}


/* =====================================================
   NAV
===================================================== */

.nav {

    display: flex;

    align-items: center;

    gap: 4px;

    flex: 1;

    overflow-x: auto;

}


.nav::-webkit-scrollbar {

    display: none;

}


.nav a {

    padding: 8px 11px;

    border-radius: 7px;

    color: #d9e1e8;

    font-size: 13px;

    white-space: nowrap;

}


.nav a:hover,
.nav a.active {

    background: var(--green);

    color: white;

}


/* =====================================================
   ACTIONS
===================================================== */

.actions {

    display: flex;

    align-items: center;

    gap: 7px;

}


.visitor-time {

    display: flex;

    align-items: center;

    gap: 5px;

    padding: 8px 9px;

    border-radius: 8px;

    background:
        rgba(255,255,255,.08);

    color: white;

    font-size: 12px;

    font-weight: bold;

    direction: ltr;

    white-space: nowrap;

}


.visitor-time span {

    min-width: 40px;

    text-align: center;

}


.icon-btn {

    width: 39px;

    height: 39px;

    border:
        1px solid #294056;

    border-radius: 8px;

    background: #102337;

    color: white;

    cursor: pointer;

    font-size: 16px;

}


/* =====================================================
   CONTAINER
===================================================== */

.container {

    max-width: 1100px;

    margin: auto;

    padding:
        25px 18px 60px;

}


/* =====================================================
   BREADCRUMB
===================================================== */

.breadcrumb {

    display: flex;

    align-items: center;

    gap: 8px;

    color: var(--muted);

    font-size: 12px;

    margin-bottom: 15px;

}


.breadcrumb a {

    color: var(--green);

    font-weight: bold;

}


/* =====================================================
   MATCH HERO
===================================================== */

.match-hero {

    background:
        linear-gradient(
            135deg,
            #07111f,
            #0d3b2c
        );

    color: white;

    border-radius: 20px;

    padding: 30px 25px;

    box-shadow: var(--shadow);

    overflow: hidden;

}


/* =====================================================
   COMPETITION
===================================================== */

.competition {

    text-align: center;

    margin-bottom: 25px;

}


.competition-name {

    display: inline-block;

    background:
        rgba(255,255,255,.10);

    border:
        1px solid
        rgba(255,255,255,.12);

    padding:
        6px 14px;

    border-radius: 30px;

    font-size: 12px;

    font-weight: bold;

}


/* =====================================================
   MATCH STATUS
===================================================== */

.match-status {

    text-align: center;

    margin-bottom: 20px;

}


.status {

    display: inline-block;

    padding:
        5px 12px;

    border-radius: 20px;

    font-size: 11px;

    font-weight: bold;

}


.status.scheduled {

    background: #dcfce7;

    color: #15803d;

}


.status.live {

    background: #fee2e2;

    color: #dc2626;

}


.status.finished {

    background: #e2e8f0;

    color: #475569;

}


.status.postponed {

    background: #fef3c7;

    color: #b45309;

}


/* =====================================================
   TEAMS
===================================================== */

.teams {

    display: grid;

    grid-template-columns:
        1fr
        120px
        1fr;

    align-items: center;

    gap: 15px;

}


.team {

    text-align: center;

}


.team-logo,
.team-logo-placeholder {

    width: 90px;

    height: 90px;

    margin:
        0 auto 12px;

}


.team-logo {

    object-fit: contain;

}


.team-logo-placeholder {

    display: flex;

    align-items: center;

    justify-content: center;

    background:
        rgba(255,255,255,.10);

    border:
        1px solid
        rgba(255,255,255,.15);

    border-radius: 50%;

    font-size: 35px;

}


.team-name {

    font-size: 18px;

    font-weight: 900;

}


.team-short {

    color: #aab7c4;

    font-size: 10px;

    margin-top: 3px;

}


/* =====================================================
   SCORE
===================================================== */

.score-area {

    text-align: center;

}


.score {

    font-size: 42px;

    line-height: 1;

    font-weight: 900;

    letter-spacing: 2px;

}


.vs {

    color: #aab7c4;

    font-size: 13px;

    margin-top: 8px;

}


.match-date {

    color: #d5dde5;

    font-size: 12px;

    margin-top: 14px;

}


/* =====================================================
   INFO
===================================================== */

.match-info {

    display: grid;

    grid-template-columns:
        repeat(3,1fr);

    gap: 12px;

    margin-top: 20px;

}


.info-card {

    background: var(--card);

    border:
        1px solid var(--border);

    border-radius: 12px;

    padding: 18px;

    text-align: center;

    box-shadow: var(--shadow);

}


.info-icon {

    font-size: 24px;

    margin-bottom: 5px;

}


.info-label {

    color: var(--muted);

    font-size: 10px;

}


.info-value {

    margin-top: 3px;

    font-size: 13px;

    font-weight: bold;

}


/* =====================================================
   BACK
===================================================== */

.back-button {

    display: inline-flex;

    align-items: center;

    gap: 7px;

    margin-top: 20px;

    padding:
        10px 16px;

    background: var(--card);

    border:
        1px solid var(--border);

    border-radius: 9px;

    color: var(--text);

    font-size: 12px;

    font-weight: bold;

}


.back-button:hover {

    color: var(--green);

    border-color: var(--green);

}


/* =====================================================
   LOADING / ERROR
===================================================== */

.loading,
.error,
.not-found {

    background: var(--card);

    border:
        1px solid var(--border);

    border-radius: 15px;

    padding: 45px 20px;

    text-align: center;

    color: var(--muted);

    box-shadow: var(--shadow);

}


.error {

    color: #dc2626;

}


/* =====================================================
   FOOTER
===================================================== */

.footer {

    background: #050c15;

    color: #aab5c1;

    padding: 35px 18px;

    text-align: center;

}


.footer-logo {

    color: white;

    font-size: 24px;

    font-weight: 900;

}


.footer-logo span {

    color: var(--green);

}


.footer-text {

    margin-top: 7px;

    font-size: 11px;

}


/* =====================================================
   MOBILE
===================================================== */

@media(max-width: 700px) {

    .header-inner {

        flex-wrap: wrap;

    }


    .nav {

        order: 3;

        flex-basis: 100%;

    }


    .teams {

        grid-template-columns:
            1fr
            90px
            1fr;

        gap: 5px;

    }


    .team-logo,
    .team-logo-placeholder {

        width: 70px;

        height: 70px;

    }


    .team-name {

        font-size: 14px;

    }


    .score {

        font-size: 32px;

    }


    .match-info {

        grid-template-columns: 1fr;

    }

}


@media(max-width: 480px) {

    .container {

        padding:
            18px 10px 45px;

    }


    .logo {

        font-size: 21px;

        min-width: 110px;

    }


    .visitor-time {

        font-size: 10px;

    }


    .match-hero {

        padding:
            25px 12px;

    }


    .teams {

        grid-template-columns:
            1fr
            70px
            1fr;

    }


    .team-logo,
    .team-logo-placeholder {

        width: 58px;

        height: 58px;

    }


    .team-name {

        font-size: 12px;

    }


    .score {

        font-size: 27px;

    }

}

</style>

</head>


<body>


<!-- =====================================================
     HEADER
===================================================== -->

<header class="header">

<div class="header-inner">


<a
    href="index.html"
    class="logo"
>

    Tacti<span>Gol</span>

    <small>
        NEWS
    </small>

</a>


<nav class="nav">

    <a href="index.html">
        🏠 الرئيسية
    </a>

    <a
        href="matches.html"
        class="active"
    >
        ⚽ المباريات
    </a>

    <a href="index.html#latest">
        📰 الأخبار
    </a>

    <a href="index.html#competitions">
        🏆 البطولات
    </a>

    <a href="transfers.html">
        🔄 الانتقالات
    </a>

</nav>


<div class="actions">


<div
    id="visitorTime"
    class="visitor-time"
>

    ☀️

    <span>
        --:--
    </span>

</div>


<button
    id="darkBtn"
    class="icon-btn"
    type="button"
>

    🌙

</button>


</div>

</div>

</header>


<!-- =====================================================
     MAIN
===================================================== -->

<main class="container">


<div class="breadcrumb">

    <a href="index.html">
        الرئيسية
    </a>

    <span>
        /
    </span>

    <a href="matches.html">
        المباريات
    </a>

    <span>
        /
    </span>

    <span>
        تفاصيل المباراة
    </span>

</div>


<!-- =====================================================
     CONTENT
===================================================== -->

<div id="matchContainer">

    <div class="loading">

        ⏳ جاري تحميل المباراة...

    </div>

</div>


</main>


<!-- =====================================================
     FOOTER
===================================================== -->

<footer class="footer">

<div class="footer-logo">

    Tacti<span>Gol</span> News

</div>


<div class="footer-text">

    أخبار كرة القدم لحظة بلحظة

</div>


<div class="footer-text">

    © 2026 TactiGol News — جميع الحقوق محفوظة

</div>

</footer>


<!-- =====================================================
     SUPABASE
===================================================== -->

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>


<script>

/* =====================================================
   SUPABASE CONFIG
===================================================== */

const SUPABASE_URL =
    "https://kjmvewppokrzcbegxmwg.supabase.co";


const SUPABASE_ANON_KEY =
    "sb_publishable_As8JEhEsIfOta6cyi6e_AA_tp-T9k0W";


const client =
    window.supabase.createClient(
        SUPABASE_URL,
        SUPABASE_ANON_KEY
    );


/* =====================================================
   ELEMENTS
===================================================== */

const matchContainer =
    document.getElementById(
        "matchContainer"
    );


/* =====================================================
   GET MATCH ID
===================================================== */

const params =
    new URLSearchParams(
        window.location.search
    );


const matchId =
    params.get("id");


/* =====================================================
   ESCAPE HTML
===================================================== */

function escapeHtml(value) {

    return String(
        value ?? ""
    )

    .replaceAll(
        "&",
        "&amp;"
    )

    .replaceAll(
        "<",
        "&lt;"
    )

    .replaceAll(
        ">",
        "&gt;"
    )

    .replaceAll(
        '"',
        "&quot;"
    )

    .replaceAll(
        "'",
        "&#039;"
    );

}


/* =====================================================
   DATE FORMAT
===================================================== */

function formatDate(date) {

    if (!date) {

        return "غير محدد";

    }


    const d =
        new Date(date);


    if (
        Number.isNaN(
            d.getTime()
        )
    ) {

        return "غير محدد";

    }


    return d.toLocaleDateString(
        "ar-MA",
        {
            weekday: "long",
            year: "numeric",
            month: "long",
            day: "numeric"
        }
    );

}


/* =====================================================
   TIME FORMAT
===================================================== */

function formatMatchTime(date) {

    if (!date) {

        return "--:--";

    }


    const d =
        new Date(date);


    if (
        Number.isNaN(
            d.getTime()
        )
    ) {

        return "--:--";

    }


    return d.toLocaleTimeString(
        [],
        {
            hour: "2-digit",
            minute: "2-digit",
            hour12: false
        }
    );

}


/* =====================================================
   STATUS TEXT
===================================================== */

function getStatusText(status) {

    switch (status) {

        case "live":
            return "🔴 مباشر";

        case "finished":
            return "انتهت";

        case "postponed":
            return "مؤجلة";

        case "scheduled":
            return "قادمة";

        default:
            return status || "غير محدد";

    }

}


/* =====================================================
   STATUS CLASS
===================================================== */

function getStatusClass(status) {

    if (
        [
            "live",
            "finished",
            "postponed",
            "scheduled"
        ].includes(status)
    ) {

        return status;

    }


    return "scheduled";

}


/* =====================================================
   TEAM LOGO
===================================================== */

function teamLogo(logo, name) {

    if (logo) {

        return `

            <img
                class="team-logo"
                src="${escapeHtml(logo)}"
                alt="${escapeHtml(name)}"
            >

        `;

    }


    return `

        <div
            class="team-logo-placeholder"
        >

            ⚽

        </div>

    `;

}


/* =====================================================
   SCORE
===================================================== */

function getScore(match) {

    const home =
        match.home_score;

    const away =
        match.away_score;


    if (
        home !== null &&
        home !== undefined &&
        away !== null &&
        away !== undefined
    ) {

        return `

            <div class="score">

                ${escapeHtml(home)}
                -
                ${escapeHtml(away)}

            </div>

        `;

    }


    return `

        <div class="score">

            -

        </div>

    `;

}


/* =====================================================
   RENDER MATCH
===================================================== */

function renderMatch(match) {

    const competition =
        match.competition ||
        "مباراة";


    const homeTeam =
        match.home_team ||
        "الفريق المضيف";


    const awayTeam =
        match.away_team ||
        "الفريق الضيف";


    const status =
        match.status ||
        "scheduled";


    const stadium =
        match.stadium ||
        "غير محدد";


    matchContainer.innerHTML = `

<section class="match-hero">


    <div class="competition">

        <span class="competition-name">

            🏆
            ${escapeHtml(
                competition
            )}

        </span>

    </div>


    <div class="match-status">

        <span
            class="status
            ${getStatusClass(status)}"
        >

            ${escapeHtml(
                getStatusText(status)
            )}

        </span>

    </div>


    <div class="teams">


        <!-- HOME -->

        <div class="team">

            ${teamLogo(
                match.home_logo,
                homeTeam
            )}

            <div class="team-name">

                ${escapeHtml(
                    homeTeam
                )}

            </div>

            <div class="team-short">

                ${escapeHtml(
                    match.home_team_id
                    ? "الفريق المضيف"
                    : ""
                )}

            </div>

        </div>


        <!-- SCORE -->

        <div class="score-area">

            ${getScore(match)}

            <div class="vs">

                ${
                    status === "live"
                    ? "مباشر الآن"
                    : "VS"
                }

            </div>


            <div class="match-date">

                📅
                ${formatDate(
                    match.match_date
                )}

                <br>

                🕐
                ${formatMatchTime(
                    match.match_date
                )}

            </div>

        </div>


        <!-- AWAY -->

        <div class="team">

            ${teamLogo(
                match.away_logo,
                awayTeam
            )}

            <div class="team-name">

                ${escapeHtml(
                    awayTeam
                )}

            </div>

            <div class="team-short">

                ${escapeHtml(
                    match.away_team_id
                    ? "الفريق الضيف"
                    : ""
                )}

            </div>

        </div>


    </div>

</section>


<!-- =====================================================
     MATCH INFO
===================================================== -->

<div class="match-info">


    <div class="info-card">

        <div class="info-icon">
            🏆
        </div>

        <div class="info-label">
            البطولة
        </div>

        <div class="info-value">

            ${escapeHtml(
                competition
            )}

        </div>

    </div>


    <div class="info-card">

        <div class="info-icon">
            📅
        </div>

        <div class="info-label">
            الموعد
        </div>

        <div class="info-value">

            ${formatDate(
                match.match_date
            )}

            <br>

            ${formatMatchTime(
                match.match_date
            )}

        </div>

    </div>


    <div class="info-card">

        <div class="info-icon">
            🏟️
        </div>

        <div class="info-label">
            الملعب
        </div>

        <div class="info-value">

            ${escapeHtml(
                stadium
            )}

        </div>

    </div>


</div>


<a
    href="matches.html"
    class="back-button"
>

    ← العودة إلى جميع المباريات

</a>

`;

}


/* =====================================================
   LOAD MATCH
===================================================== */

async function loadMatch() {


    if (!matchId) {

        matchContainer.innerHTML = `

            <div class="error">

                ❌ لم يتم تحديد رقم المباراة.

                <br><br>

                افتح الصفحة بهذا الشكل:

                <br><br>

                <strong>
                    match.html?id=1
                </strong>

            </div>

        `;

        return;

    }


    /* ================================================
       CHECK ID
    ================================================ */

    const id =
        Number(matchId);


    if (
        !Number.isInteger(id) ||
        id <= 0
    ) {

        matchContainer.innerHTML = `

            <div class="error">

                ❌ رقم المباراة غير صحيح.

            </div>

        `;

        return;

    }


    /* ================================================
       QUERY SUPABASE
    ================================================ */

    const {
        data,
        error
    } = await client

        .from("matches")

        .select("*")

        .eq(
            "id",
            id
        )

        .single();


    /* ================================================
       ERROR
    ================================================ */

    if (error) {

        console.error(
            "Match error:",
            error
        );


        matchContainer.innerHTML = `

            <div class="error">

                ❌ حدث خطأ أثناء تحميل المباراة.

                <br><br>

                ${escapeHtml(
                    error.message
                )}

            </div>

        `;

        return;

    }


    /* ================================================
       NOT FOUND
    ================================================ */

    if (!data) {

        matchContainer.innerHTML = `

            <div class="not-found">

                ⚽

                <br><br>

                المباراة غير موجودة.

                <br><br>

                <a
                    href="matches.html"
                    class="back-button"
                >

                    العودة إلى المباريات

                </a>

            </div>

        `;

        return;

    }


    /* ================================================
       RENDER
    ================================================ */

    renderMatch(data);

}


/* =====================================================
   VISITOR TIME
===================================================== */

function updateVisitorTime() {

    const now =
        new Date();


    const time =
        now.toLocaleTimeString(
            [],
            {
                hour: "2-digit",
                minute: "2-digit",
                hour12: false
            }
        );


    const hour =
        now.getHours();


    const icon =
        hour >= 6 &&
        hour < 19
            ? "☀️"
            : "🌙";


    const element =
        document.getElementById(
            "visitorTime"
        );


    if (element) {

        element.innerHTML =
            `${icon} <span>${time}</span>`;

    }

}


updateVisitorTime();


setInterval(
    updateVisitorTime,
    1000
);


/* =====================================================
   DARK MODE
===================================================== */

const darkBtn =
    document.getElementById(
        "darkBtn"
    );


function updateDarkButton() {

    if (!darkBtn) return;


    darkBtn.textContent =

        document.body
        .classList
        .contains("dark")

        ? "☀️"

        : "🌙";

}


darkBtn.addEventListener(
    "click",
    function() {

        document.body
        .classList
        .toggle("dark");


        localStorage.setItem(
            "tactigol-dark",
            document.body
            .classList
            .contains("dark")
        );


        updateDarkButton();

    }
);


if (
    localStorage.getItem(
        "tactigol-dark"
    ) === "true"
) {

    document.body
    .classList
    .add("dark");

}


updateDarkButton();


