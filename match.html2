<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>تفاصيل المباراة | TactiGol News</title>

<meta name="description"
      content="تفاصيل مباريات كرة القدم ونتائجها - TactiGol News">

<style>

/* =====================================================
   VARIABLES
===================================================== */

:root {

    --primary: #00a86b;
    --primary-dark: #078153;

    --bg: #f4f6f8;
    --card: #ffffff;

    --text: #111827;
    --muted: #6b7280;

    --border: #e5e7eb;

    --danger: #dc2626;

    --shadow:
        0 8px 25px rgba(0,0,0,.07);
}


/* =====================================================
   DARK MODE
===================================================== */

body.dark {

    --bg: #07111f;
    --card: #0f1b2b;

    --text: #f3f4f6;
    --muted: #aab4c0;

    --border: #263548;

    --shadow:
        0 8px 25px rgba(0,0,0,.25);
}


/* =====================================================
   RESET
===================================================== */

* {

    box-sizing: border-box;

    margin: 0;

    padding: 0;
}


html {

    scroll-behavior: smooth;
}


body {

    font-family:
        Arial,
        Tahoma,
        sans-serif;

    background: var(--bg);

    color: var(--text);

    line-height: 1.7;

    transition:
        background .25s,
        color .25s;
}


a {

    color: inherit;

    text-decoration: none;
}


button {

    font-family: inherit;
}


/* =====================================================
   HEADER
===================================================== */

.header {

    background:
        linear-gradient(
            135deg,
            #07111f,
            #0d2136
        );

    color: white;

    position: sticky;

    top: 0;

    z-index: 1000;

    box-shadow:
        0 4px 20px rgba(0,0,0,.18);
}


.header-inner {

    max-width: 1200px;

    min-height: 72px;

    margin: auto;

    padding:
        10px 18px;

    display: flex;

    align-items: center;

    gap: 20px;
}


/* =====================================================
   LOGO
===================================================== */

.logo {

    min-width: 150px;

    font-size: 27px;

    font-weight: 900;

    line-height: 1.1;
}


.logo span {

    color: var(--primary);
}


.logo small {

    display: block;

    color: #9ca9b7;

    font-size: 8px;

    letter-spacing: 4px;

    text-align: center;
}


/* =====================================================
   NAVIGATION
===================================================== */

.nav {

    display: flex;

    align-items: center;

    gap: 4px;

    flex: 1;

    overflow-x: auto;
}


.nav::-webkit-scrollbar {

    display: none;
}


.nav a {

    padding:
        8px 12px;

    border-radius: 7px;

    color: #d9e1e8;

    font-size: 14px;

    white-space: nowrap;
}


.nav a:hover {

    background:
        var(--primary);

    color: white;
}


.nav a.active {

    background:
        var(--primary);

    color: white;
}


/* =====================================================
   ACTIONS
===================================================== */

.actions {

    display: flex;

    align-items: center;

    gap: 7px;
}


.visitor-time {

    display: flex;

    align-items: center;

    gap: 5px;

    padding:
        8px 9px;

    border-radius: 8px;

    background:
        rgba(255,255,255,.08);

    color: white;

    font-size: 13px;

    font-weight: bold;

    direction: ltr;

    white-space: nowrap;
}


.visitor-time span {

    min-width: 40px;

    text-align: center;
}


.icon-btn {

    width: 40px;

    height: 40px;

    border:
        1px solid #294056;

    border-radius: 8px;

    background: #102337;

    color: white;

    cursor: pointer;

    font-size: 17px;
}


.icon-btn:hover {

    background:
        #18334d;
}


/* =====================================================
   CONTAINER
===================================================== */

.container {

    max-width: 1050px;

    margin: auto;

    padding:
        28px 18px 60px;
}


/* =====================================================
   BACK BUTTON
===================================================== */

.back-button {

    display: inline-flex;

    align-items: center;

    gap: 7px;

    margin-bottom: 18px;

    padding:
        9px 15px;

    border:
        1px solid var(--border);

    background: var(--card);

    color: var(--text);

    border-radius: 8px;

    font-size: 13px;

    box-shadow:
        0 3px 10px rgba(0,0,0,.04);

    transition:
        .2s;
}


.back-button:hover {

    border-color:
        var(--primary);

    color:
        var(--primary);

    transform:
        translateY(-1px);
}


/* =====================================================
   MATCH HERO
===================================================== */

.match-hero {

    background:
        var(--card);

    border:
        1px solid var(--border);

    border-radius: 18px;

    box-shadow:
        var(--shadow);

    overflow: hidden;

    margin-bottom: 20px;
}


/* =====================================================
   COMPETITION
===================================================== */

.competition-bar {

    display: flex;

    align-items: center;

    justify-content: center;

    gap: 8px;

    padding:
        14px;

    background:
        rgba(0,168,107,.07);

    border-bottom:
        1px solid var(--border);

    color:
        var(--primary);

    font-size: 14px;

    font-weight: bold;
}


/* =====================================================
   MATCH DATE
===================================================== */

.match-date {

    text-align: center;

    padding:
        18px 15px 5px;

    color: var(--muted);

    font-size: 13px;
}


/* =====================================================
   TEAMS AREA
===================================================== */

.teams-area {

    display: grid;

    grid-template-columns:
        1fr 160px 1fr;

    align-items: center;

    gap: 20px;

    padding:
        25px 35px 35px;
}


/* =====================================================
   TEAM
===================================================== */

.team-box {

    display: flex;

    flex-direction: column;

    align-items: center;

    text-align: center;

    gap: 10px;
}


.team-logo {

    width: 90px;

    height: 90px;

    object-fit: contain;
}


.team-placeholder {

    width: 90px;

    height: 90px;

    display: flex;

    align-items: center;

    justify-content: center;

    border-radius: 50%;

    background:
        var(--bg);

    font-size: 42px;

    border:
        1px solid var(--border);
}


.team-name {

    font-size: 20px;

    font-weight: 900;
}


/* =====================================================
   SCORE
===================================================== */

.score-center {

    text-align: center;
}


.score {

    font-size: 48px;

    line-height: 1.1;

    font-weight: 900;

    letter-spacing: 2px;
}


.score-vs {

    font-size: 18px;

    color: var(--muted);

    font-weight: bold;
}


/* =====================================================
   STATUS
===================================================== */

.match-status {

    display: inline-flex;

    align-items: center;

    justify-content: center;

    padding:
        6px 13px;

    border-radius: 30px;

    font-size: 11px;

    font-weight: bold;

    margin-top: 8px;
}


.match-status.scheduled {

    background:
        #dcfce7;

    color:
        #15803d;
}


.match-status.live {

    background:
        #fee2e2;

    color:
        #dc2626;
}


.match-status.finished {

    background:
        #e5e7eb;

    color:
        #475569;
}


.match-status.postponed {

    background:
        #fef3c7;

    color:
        #b45309;
}


/* =====================================================
   DETAILS
===================================================== */

.details-card {

    background:
        var(--card);

    border:
        1px solid var(--border);

    border-radius: 14px;

    box-shadow:
        var(--shadow);

    overflow: hidden;

    margin-bottom: 20px;
}


.details-title {

    padding:
        15px 18px;

    border-bottom:
        1px solid var(--border);

    font-size: 17px;

    font-weight: 900;
}


.details-grid {

    display: grid;

    grid-template-columns:
        repeat(3, 1fr);
}


.detail {

    padding:
        18px;

    text-align: center;

    border-left:
        1px solid var(--border);
}


.detail:last-child {

    border-left: 0;
}


.detail-icon {

    font-size: 22px;

    margin-bottom: 5px;
}


.detail-label {

    color: var(--muted);

    font-size: 11px;

    margin-bottom: 2px;
}


.detail-value {

    font-size: 14px;

    font-weight: bold;
}


/* =====================================================
   LOADING
===================================================== */

.loading {

    background:
        var(--card);

    border:
        1px solid var(--border);

    border-radius: 15px;

    padding:
        60px 20px;

    text-align: center;

    color: var(--muted);

    box-shadow:
        var(--shadow);
}


/* =====================================================
   ERROR
===================================================== */

.error-box {

    background:
        var(--card);

    border:
        1px solid #fecaca;

    border-radius: 15px;

    padding:
        45px 20px;

    text-align: center;

    color:
        #dc2626;

    box-shadow:
        var(--shadow);
}


.error-icon {

    font-size: 40px;

    margin-bottom: 10px;
}


/* =====================================================
   FOOTER
===================================================== */

.footer {

    background:
        #050c15;

    color:
        #aab5c1;

    padding:
        35px 18px;
}


.footer-inner {

    max-width: 1050px;

    margin: auto;

    text-align: center;
}


.footer-logo {

    color: white;

    font-size: 24px;

    font-weight: 900;
}


.footer-logo span {

    color:
        var(--primary);
}


.footer-text {

    margin-top: 7px;

    font-size: 12px;
}


/* =====================================================
   MOBILE
===================================================== */

@media(max-width:750px) {

    .header-inner {

        flex-wrap: wrap;

        gap: 10px;
    }


    .nav {

        order: 3;

        flex-basis: 100%;
    }


    .teams-area {

        grid-template-columns:
            1fr 100px 1fr;

        gap: 8px;

        padding:
            22px 12px 30px;
    }


    .team-logo,
    .team-placeholder {

        width: 65px;

        height: 65px;
    }


    .team-placeholder {

        font-size: 30px;
    }


    .team-name {

        font-size: 15px;
    }


    .score {

        font-size: 34px;
    }


    .details-grid {

        grid-template-columns:
            1fr;
    }


    .detail {

        border-left: 0;

        border-bottom:
            1px solid var(--border);
    }


    .detail:last-child {

        border-bottom: 0;
    }

}


@media(max-width:500px) {

    .logo {

        min-width: 120px;

        font-size: 22px;
    }


    .actions {

        margin-right: auto;
    }


    .visitor-time {

        font-size: 11px;

        padding:
            7px;
    }


    .container {

        padding:
            18px 10px 45px;
    }


    .teams-area {

        grid-template-columns:
            1fr 75px 1fr;

        gap: 3px;
    }


    .team-name {

        font-size: 12px;
    }


    .score {

        font-size: 28px;
    }


    .score-vs {

        font-size: 14px;
    }


    .match-date {

        font-size: 11px;
    }

}

</style>
</head>


<body>


<!-- =====================================================
     HEADER
===================================================== -->

<header class="header">

    <div class="header-inner">


        <a
            href="index.html"
            class="logo"
        >

            Tacti<span>Gol</span>

            <small>
                NEWS
            </small>

        </a>


        <nav class="nav">

            <a href="index.html">
                الرئيسية
            </a>

            <a
                href="matches.html"
                class="active"
            >
                ⚽ المباريات
            </a>

            <a href="index.html#latest">
                📰 الأخبار
            </a>

            <a href="index.html#competitions">
                🏆 البطولات
            </a>

            <a href="index.html#transfers">
                🔄 الانتقالات
            </a>

        </nav>


        <div class="actions">

            <div
                id="visitorTime"
                class="visitor-time"
            >

                ☀️

                <span>
                    --:--
                </span>

            </div>


            <button
                id="darkBtn"
                class="icon-btn"
                type="button"
                title="الوضع الليلي"
            >
                🌙
            </button>

        </div>

    </div>

</header>


<!-- =====================================================
     MAIN
===================================================== -->

<main class="container">


    <a
        href="matches.html"
        class="back-button"
    >

        ←

        العودة إلى جميع المباريات

    </a>


    <div id="matchContainer">

        <div class="loading">

            ⏳ جاري تحميل تفاصيل المباراة...

        </div>

    </div>


</main>


<!-- =====================================================
     FOOTER
===================================================== -->

<footer class="footer">

    <div class="footer-inner">

        <div class="footer-logo">

            Tacti<span>Gol</span> News

        </div>

        <div class="footer-text">

            أخبار كرة القدم لحظة بلحظة

        </div>

        <div class="footer-text">

            © 2026 TactiGol News — جميع الحقوق محفوظة

        </div>

    </div>

</footer>


<!-- =====================================================
     SUPABASE
===================================================== -->

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>


<script>

/* =====================================================
   SUPABASE
===================================================== */

const SUPABASE_URL =
    "https://kjmvewppokrzcbegxmwg.supabase.co";


const SUPABASE_KEY =
    "sb_publishable_As8JEhEsIfOta6cyi6e_AA_tp-T9k0W";


const client =
    window.supabase.createClient(
        SUPABASE_URL,
        SUPABASE_KEY
    );


/* =====================================================
   GET MATCH ID
===================================================== */

const params =
    new URLSearchParams(
        window.location.search
    );


const matchId =
    params.get("id");


/* =====================================================
   ESCAPE HTML
===================================================== */

function escapeHtml(value) {

    return String(
        value ?? ""
    )
    .replaceAll("&","&amp;")
    .replaceAll("<","&lt;")
    .replaceAll(">","&gt;")
    .replaceAll('"',"&quot;")
    .replaceAll("'","&#039;");

}


/* =====================================================
   FORMAT DATE
===================================================== */

function formatDate(date) {

    if (!date)
        return "غير محدد";


    const d =
        new Date(date);


    if (
        Number.isNaN(
            d.getTime()
        )
    )
        return "غير محدد";


    return d.toLocaleDateString(
        "ar-MA",
        {
            weekday:"long",
            year:"numeric",
            month:"long",
            day:"numeric"
        }
    );

}


/* =====================================================
   FORMAT TIME
===================================================== */

function formatTime(date) {

    if (!date)
        return "--:--";


    const d =
        new Date(date);


    if (
        Number.isNaN(
            d.getTime()
        )
    )
        return "--:--";


    return d.toLocaleTimeString(
        [],
        {
            hour:"2-digit",
            minute:"2-digit",
            hour12:false
        }
    );

}


/* =====================================================
   STATUS
===================================================== */

function getStatus(status) {

    switch(status) {

        case "live":

            return {
                text:"🔴 المباراة مباشرة",
                className:"live"
            };


        case "finished":

            return {
                text:"✅ انتهت المباراة",
                className:"finished"
            };


        case "postponed":

            return {
                text:"⏸️ المباراة مؤجلة",
                className:"postponed"
            };


        default:

            return {
                text:"⏰ المباراة مبرمجة",
                className:"scheduled"
            };

    }

}


/* =====================================================
   TEAM LOGO
===================================================== */

function teamLogo(
    logo,
    teamName
) {

    if (logo) {

        return `

            <img
                class="team-logo"
                src="${escapeHtml(logo)}"
                alt="${escapeHtml(teamName)}"
            >

        `;

    }


    return `

        <div class="team-placeholder">

            ⚽

        </div>

    `;

}


/* =====================================================
   RENDER MATCH
===================================================== */

function renderMatch(match) {

    const container =
        document.getElementById(
            "matchContainer"
        );


    const status =
        getStatus(
            match.status
        );


    const homeTeam =
        match.home_team ||
        "الفريق المضيف";


    const awayTeam =
        match.away_team ||
        "الفريق الضيف";


    let score =
        `<span class="score-vs">VS</span>`;


    if (
        match.home_score !== null &&
        match.home_score !== undefined &&
        match.away_score !== null &&
        match.away_score !== undefined
    ) {

        score = `

            <div class="score">

                ${escapeHtml(
                    match.home_score
                )}

                -

                ${escapeHtml(
                    match.away_score
                )}

            </div>

        `;

    }


    document.title =
        `${homeTeam} × ${awayTeam} | TactiGol News`;


    container.innerHTML = `

        <section class="match-hero">


            <div class="competition-bar">

                🏆

                ${escapeHtml(
                    match.competition ||
                    "مباراة كرة قدم"
                )}

            </div>


            <div class="match-date">

                ${formatDate(
                    match.match_date
                )}

                <br>

                🕐

                ${formatTime(
                    match.match_date
                )}

            </div>


            <div class="teams-area">


                <!-- HOME -->

                <div class="team-box">

                    ${teamLogo(
                        match.home_logo,
                        homeTeam
                    )}

                    <div class="team-name">

                        ${escapeHtml(
                            homeTeam
                        )}

                    </div>

                </div>


                <!-- SCORE -->

                <div class="score-center">

                    ${score}


                    <div
                        class="
                            match-status
                            ${status.className}
                        "
                    >

                        ${status.text}

                    </div>

                </div>


                <!-- AWAY -->

                <div class="team-box">

                    ${teamLogo(
                        match.away_logo,
                        awayTeam
                    )}

                    <div class="team-name">

                        ${escapeHtml(
                            awayTeam
                        )}

                    </div>

                </div>


            </div>

        </section>


        <section class="details-card">


            <div class="details-title">

                📋 تفاصيل المباراة

            </div>


            <div class="details-grid">


                <div class="detail">

                    <div class="detail-icon">

                        🏆

                    </div>

                    <div class="detail-label">

                        البطولة

                    </div>

                    <div class="detail-value">

                        ${escapeHtml(
                            match.competition ||
                            "غير محدد"
                        )}

                    </div>

                </div>


                <div class="detail">

                    <div class="detail-icon">

                        📅

                    </div>

                    <div class="detail-label">

                        التاريخ والوقت

                    </div>

                    <div class="detail-value">

                        ${formatDate(
                            match.match_date
                        )}

                        <br>

                        ${formatTime(
                            match.match_date
                        )}

                    </div>

                </div>


                <div class="detail">

                    <div class="detail-icon">

                        🏟️

                    </div>

                    <div class="detail-label">

                        الملعب

                    </div>

                    <div class="detail-value">

                        ${escapeHtml(
                            match.stadium ||
                            "لم يتم تحديد الملعب"
                        )}

                    </div>

                </div>


            </div>

        </section>


        <section class="details-card">


            <div class="details-title">

                ⚽ المباراة

            </div>


            <div
                style="
                    padding:25px;
                    text-align:center;
                    color:var(--muted);
                "
            >

                تابع TactiGol News للحصول على
                آخر أخبار وتفاصيل المباراة.

            </div>


        </section>

    `;

}


/* =====================================================
   ERROR
===================================================== */

function showError(message) {

    document.getElementById(
        "matchContainer"
    ).innerHTML = `

        <div class="error-box">

            <div class="error-icon">
                ⚠️
            </div>

            <h2>
                ${escapeHtml(message)}
            </h2>

            <p
                style="
                    margin-top:8px;
                    color:var(--muted);
                "
            >

                تأكد من أن رابط المباراة صحيح.

            </p>

            <a
                href="matches.html"
                class="back-button"
                style="margin-top:20px;"
            >

                ← العودة إلى المباريات

            </a>

        </div>

    `;

}


/* =====================================================
   LOAD MATCH
===================================================== */

async function loadMatch() {

    if (!matchId) {

        showError(
            "لم يتم تحديد رقم المباراة"
        );

        return;

    }


    try {

        const result =
            await client
            .from("matches")
            .select("*")
            .eq(
                "id",
                matchId
            )
            .single();


        if (result.error) {

            console.error(
                "Supabase match:",
                result.error
            );


            showError(
                "تعذر تحميل المباراة"
            );

            return;

        }


        if (!result.data) {

            showError(
                "المباراة غير موجودة"
            );

            return;

        }


        renderMatch(
            result.data
        );

    }
    catch(error) {

        console.error(
            "Match error:",
            error
        );


        showError(
            "حدث خطأ أثناء تحميل المباراة"
        );

    }

}


/* =====================================================
   DARK MODE
===================================================== */

const darkBtn =
    document.getElementById(
        "darkBtn"
    );


function updateDarkButton() {

    darkBtn.textContent =
        document.body.classList.contains(
            "dark"
        )
        ? "☀️"
        : "🌙";

}


darkBtn.addEventListener(
    "click",
    function() {

        document.body.classList.toggle(
            "dark"
        );


        const isDark =
            document.body.classList.contains(
                "dark"
            );


        localStorage.setItem(
            "tactigol-dark",
            isDark
        );


        updateDarkButton();

    }
);


if (
    localStorage.getItem(
        "tactigol-dark"
    ) === "true"
) {

    document.body.classList.add(
        "dark"
    );

}


updateDarkButton();


/* =====================================================
   VISITOR TIME
===================================================== */

function updateVisitorTime() {

    const now =
        new Date();


    const time =
        now.toLocaleTimeString(
            [],
            {
                hour:"2-digit",
                minute:"2-digit",
                hour12:false
            }
        );


    const hour =
        now.getHours();


    const icon =
        hour >= 6 &&
        hour < 19

        ? "☀️"

        : "🌙";


    const element =
        document.getElementById(
            "visitorTime"
        );


    if (element) {

        element.innerHTML =
            `${icon} <span>${time}</span>`;

    }

}


updateVisitorTime();


setInterval(
    updateVisitorTime,
    1000
);


/* =====================================================
   START
===================================================== */

loadMatch();

</script>

</body>
</html>
